#!/bin/bash
# Runs when a session starts: prints where things stand and the Start checklist, and gives the session
# the agents' GitHub identity. More uses, all plain shell that any tool can call:
#   .claude/hooks/start token               prints a fresh GitHub token for the agents' app
#   .claude/hooks/start setup [key file]    a new Mac: stores the app's key, then sets up all ready checks
#   .claude/hooks/start ready               prints what this Mac still needs before it can build, or nothing
set -u
here=$(cd "$(dirname "$0")/../.." && pwd)
cd "$here" || exit 0

# The agents' GitHub App. None of this is secret; the key is in the login keychain.
client=Iv23liG69KshMKWCxVzO
author='361690794+sagar-agent[bot]'

token() {
    local cache=${TMPDIR:-/tmp}/sagar-agent-token key now head body signature where installation fresh
    if [ -n "$(find "$cache" -mmin -30 -size +0 2>/dev/null)" ]; then cat "$cache"; return; fi
    key=$(security find-generic-password -s Sagar.Agent -a key -w 2>/dev/null | base64 -d) && [ -n "$key" ] || return 1
    encode() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
    now=$(date +%s)
    head=$(printf '{"alg":"RS256","typ":"JWT"}' | encode)
    body=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 300)) "$client" | encode)
    signature=$(printf '%s.%s' "$head" "$body" | openssl dgst -sha256 -sign <(printf '%s\n' "$key") | encode)
    # Where the app is installed is asked, never written down: GitHub gives a new number each time.
    where=$(git -C "$here" remote get-url origin 2>/dev/null | sed -E 's|^.*github\.com[:/]||; s|\.git$||')
    installation=$(curl -fsS -H "Authorization: Bearer $head.$body.$signature" \
        "https://api.github.com/repos/$where/installation" 2>/dev/null | jq -er .id) || return 1
    fresh=$(curl -fsS -X POST -H "Authorization: Bearer $head.$body.$signature" \
        "https://api.github.com/app/installations/$installation/access_tokens" | jq -er .token) && [ -n "$fresh" ] || return 1
    (umask 077 && printf '%s\n' "$fresh" >"$cache")
    printf '%s\n' "$fresh"
}

answers() { # answers <owner>: reads GitHub's reply about the open pull requests, prints where each one stands.
    # The repository is public, so anyone may write on it: only its owner's review and words are his answer.
    jq -r --arg owner "$1" '
    def his: select(.author.login == $owner);
    .[] | ([.reviews[] | his | select(.state != "COMMENTED" and .state != "PENDING")] | last) as $answer
    | (([.statusCheckRollup[] | select(.name == "check")] | last | .conclusion) == "SUCCESS") as $green
    | "  #\(.number) \(.title): "
      + (if .isDraft and $green then "Draft with a green check: run Scripts/check ready \(.number); "
         elif .isDraft then "draft, not yet shown to anyone; "
         elif .autoMergeRequest == null then "Ready but not set to merge: run Scripts/check ready \(.number); " else "" end) + (
        if $answer == null then "no answer yet"
        elif $answer.state == "APPROVED" then "approved"
        elif $answer.state == "DISMISSED" then "His approval was undone by a later push: Scripts/check ready \(.number) asks him again"
        elif .headRefName | startswith("release/") then
            "Changes asked for on a release: Scripts/release \(.title | ltrimstr("Release ")) withdraw, mend it, "
            + "then the same number again; see \(.url)"
        else "Changes asked for: see \(.url)" end),
      (.reviews[], .comments[] | his | select(.body != "") | "      \(.author.login) wrote: \(.body)")'
}

# Where the owner's private notes are kept: beside the shared folder, under its name and " Private".
shared=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$here/.git")")
private="$shared Private"
# The shared folder's own hook: a chat's copy, and its hook, go when the chat is archived.
helper="!f() { test \"\$1\" = get && printf 'username=x-access-token\npassword=%s\n' \"\$($(printf %q "$shared/.claude/hooks/start") token)\"; }; f"
plugins='agent-skills@addy-agent-skills=addyosmani/agent-skills taste-skill@taste-skill=Leonxlnx/taste-skill'

# Everything that grows lives on its own drive, never on the disk that holds the owner's home folder.
on_drive() { [ "$(stat -f %d "$shared")" != "$(stat -f %d "$HOME")" ]; }
# Beside the project on the drive: the tools setup downloads, and the caches Swift and its tests fill. Neither cache
# can be moved by a setting, so each is a link from its usual place; with the drive away a write there just fails.
tools="$(dirname "$shared")/Tools" caches="$(dirname "$shared")/Caches"
moved='org.swift.swiftpm com.apple.dt.xctest.tool'
PATH=$tools/bin:$PATH
# A Mac set up by these steps carries a mark; there, work off the drive stops instead of piling up at home.
drive_mac() { [ "$(git config --global --get sagar.drive)" = yes ]; }

leftovers() { # leftovers < merged heads: chats' copies whose work has merged, which archiving their chats removes
    git worktree list --porcelain | awk '/^worktree /{copy = substr($0, 10)} /^HEAD /{print $2, copy}' | sed 1d |
        while read -r head copy; do # the first is the shared folder itself
            [ -d "$copy" ] && grep -qx "$head" <<<"$1" && [ -z "$(git -C "$copy" status --porcelain)" ] && basename "$copy"
        done | tr '\n' ' '
}

keep_caches() { # each cache becomes a link into the drive's Caches, taking along what it holds; nothing is deleted
    local cache usual
    for cache in $moved; do
        usual=$HOME/Library/Caches/$cache
        mkdir -p "$caches" ~/Library/Caches || return 1
        if [ -d "$usual" ] && [ ! -L "$usual" ] && [ ! -e "$caches/$cache" ]; then mv "$usual" "$caches/"; fi
        mkdir -p "$caches/$cache"
        # A link to an old drive is replaced; a real folder the drive already has a copy of is left, and ready says so.
        if [ -L "$usual" ] || [ ! -e "$usual" ]; then ln -sfn "$caches/$cache" "$usual"; fi
    done
}

ready() { # Checklists/Build Mac.md, as what can be seen without asking the keychain or the network.
    local wanted have='' plugin
    on_drive || echo "The project on its own drive, off the disk that holds the home folder"
    wanted=$(sed -n 's|.*Xcode_\([0-9.]*\)\.app.*|\1|p' .github/workflows/check.yml 2>/dev/null | head -1)
    # Asking xcodebuild on a Mac without Xcode would put macOS's install dialog on the owner's screen.
    ! xcode-select -p >/dev/null 2>&1 || have=$(xcodebuild -version 2>/dev/null | awk 'NR == 1 { print $2 }')
    [ -z "$wanted" ] || [ "$have" = "$wanted" ] || echo "Xcode $wanted, opened once (this Mac has ${have:-none})"
    command -v gh >/dev/null || echo "GitHub's gh, in the Tools folder beside the project"
    for cache in $moved; do
        ! on_drive || [ "$(readlink "$HOME/Library/Caches/$cache")" = "$caches/$cache" ] ||
            echo "The $cache cache, kept in the Caches folder beside the project"
    done
    [ -d "$private/.git" ] || echo "The private notes, cloned beside the repository as '$(basename "$private")'"
    for plugin in $plugins; do
        jq -e --arg p "${plugin%%=*}" '.plugins[$p]' "$HOME/.claude/plugins/installed_plugins.json" >/dev/null 2>&1 ||
            echo "The ${plugin%%@*} plugin"
    done
    [ -f "$HOME/.claude/skills/cook/SKILL.md" ] || echo "The cook skill"
    # The owner's Claude instructions and settings live only in his home folder: a copy waits in the private notes.
    for file in CLAUDE.md settings.json; do
        if [ ! -f "$HOME/.claude/$file" ]; then echo "The owner's ~/.claude/$file"
        elif [ -d "$private/.git" ] && ! cmp -s "$HOME/.claude/$file" "$private/Claude/$file"; then
            echo "A fresh copy of ~/.claude/$file in the private notes' Claude folder, committed and pushed"
        fi
    done
}

case ${1:-} in
    "") ;;
    token) token; exit ;;
    ready) ready; exit ;;
    caches) on_drive && keep_caches; exit ;;
    leftovers) leftovers "$(cat)"; exit ;;
    answers) answers "${2:?}"; exit ;;
    setup)
        on_drive || { echo "Stop: clone the project onto the external drive. Is it plugged in?"; exit 1; }
        git config --global sagar.drive yes
        [ -z "${2:-}" ] || security add-generic-password -U -s Sagar.Agent -a key -w "$(base64 -i "$2")"
        git config core.hooksPath .githooks
        git config user.name 'sagar-agent[bot]'
        git config user.email "$author@users.noreply.github.com"
        git config --replace-all credential.https://github.com.helper ''
        git config --add credential.https://github.com.helper "$helper"
        token >/dev/null && echo "The agents' identity works." || { echo "No token: is the key in the keychain?"; exit 1; }
        if ! command -v gh >/dev/null; then # GitHub's own build, checked against the sums GitHub publishes beside it
            place=$(mktemp -d)
            (cd "$place" && release=$(curl -fsS https://api.github.com/repos/cli/cli/releases/latest) &&
                zip=$(jq -er --arg chip "_macOS_$(uname -m | sed s/x86_64/amd64/).zip" \
                    '.assets[].name | select(endswith($chip))' <<<"$release") &&
                curl -fsSLO "https://github.com/cli/cli/releases/download/$(jq -r .tag_name <<<"$release")/$zip" &&
                curl -fsSL "https://github.com/cli/cli/releases/download/$(jq -r .tag_name <<<"$release")/$(jq -r \
                    '.assets[].name | select(endswith("_checksums.txt"))' <<<"$release")" | grep " $zip\$" | shasum -a 256 -c &&
                unzip -q "$zip" && mkdir -p "$tools/bin" && mv "${zip%.zip}/bin/gh" "$tools/bin/")
            status=$?
            rm -rf "$place"
            [ "$status" = 0 ] || { echo "Could not install gh from GitHub's releases."; exit 1; }
        fi
        if [ ! -d "$private/.git" ]; then
            git -c credential.helper= -c credential.helper="$helper" clone -q \
                "$(git remote get-url origin | sed 's|\.git$||')-Private" "$private" || exit 1
            git -C "$private" config credential.https://github.com.helper "$helper"
        fi
        mkdir -p ~/.claude/skills
        for file in CLAUDE.md settings.json; do [ -e ~/.claude/$file ] || cp "$private/Claude/$file" ~/.claude/; done
        # Xcode's own builds go beside the project's, on the drive, not into the home folder.
        defaults write com.apple.dt.Xcode IDECustomDerivedDataLocation "$shared/.build/Xcode"
        keep_caches
        [ -d ~/.claude/skills/cook ] || git clone -q https://github.com/Leonxlnx/cook ~/.claude/skills/cook
        for plugin in $plugins; do
            claude plugin marketplace add "${plugin#*=}" >/dev/null && claude plugin install "${plugin%%=*}" >/dev/null
        done
        ready
        exit ;;
    *) echo "Usage: .claude/hooks/start [token | ready | setup [key file] | answers <owner> < pull requests]" >&2; exit 2 ;;
esac

if drive_mac && ! on_drive; then
    echo "Stop: this copy of the project is not on its drive. Plug the drive in and open the project there. Change nothing here."
    exit 0
fi
# With no agents' token, gh must fail, never fall back to a person's own sign-in.
# The commit gate, Scripts/check, is git's own hook. Every chat shares one settings file, so it is written only when it differs.
[ "$(git config core.hooksPath)" = .githooks ] || git config core.hooksPath .githooks
git fetch -q --prune origin 2>/dev/null # then drop local branches whose pull request has merged
for gone in $(git branch --format='%(refname:short) %(upstream:track)' | awk '$2 == "[gone]" { print $1 }'); do
    # Only if GitHub merged exactly the commit this branch ends on: nothing unpushed can be lost.
    merged=$(GH_TOKEN=$(token || echo no-agent-token) gh pr view "$gone" --json state,headRefOid \
        --jq 'select(.state == "MERGED") | .headRefOid' 2>/dev/null)
    [ "$merged" != "$(git rev-parse "$gone")" ] || git branch -q -D "$gone"
done
[ -z "${CLAUDE_ENV_FILE:-}" ] || printf 'export PATH=%q:"$PATH"\n' "$tools/bin" >>"$CLAUDE_ENV_FILE"
[ -z "${CLAUDE_ENV_FILE:-}" ] ||
    echo "export GH_TOKEN=\"\$('$here/.claude/hooks/start' token || echo no-agent-token)\"" >>"$CLAUDE_ENV_FILE"
GH_TOKEN=$(token || echo no-agent-token)
export GH_TOKEN

echo "Sagar. The app in work: $(cat NOW)"
missing=$(ready; [ "$GH_TOKEN" != no-agent-token ] || echo "The agents' GitHub key")
[ -z "$missing" ] || printf 'This Mac is not yet as Checklists/Build Mac.md sets it up. Still to come:\n%s\n' "$(sed 's/^/  /' <<<"$missing")"
echo "Checkout: $(git status -sb | head -1)$(git status --porcelain | sed -n '1s/.*/, with uncommitted changes/p')"
[ "$(git rev-parse --path-format=absolute --git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ] ||
    echo "This is the shared folder, where every chat opens. Change nothing here: move into your own copy first (EnterWorktree), from origin/main. It stays on clean main, for Scripts/release alone."
# Copies of finished work are what piles up: archiving a chat removes its copy, and this shows any left behind.
merged=$(gh pr list --state merged --limit 1000 --json headRefOid --jq '.[].headRefOid' 2>/dev/null)
leftover=$(leftovers "$merged")
[ -z "$leftover" ] || echo "Copies whose work has merged, which archiving their chats removes: $leftover"
echo "Branches besides main: $(git branch --format='%(refname:short)' | grep -vx main | tr '\n' ' ')"
repository=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)
owner=${repository%/*}
echo "Open pull requests, and what the owner has answered on each. Act on his words before anything else:"
replies=$(gh pr list --limit 100 --json number,title,url,headRefName,isDraft,autoMergeRequest,statusCheckRollup,reviews,comments) &&
    answers "$owner" <<<"$replies" || echo "  Could not read the pull requests: look on GitHub before doing anything."
for number in $(gh pr list --limit 100 --json number --jq '.[].number' 2>/dev/null); do # words left beside a line
    gh api "repos/$repository/pulls/$number/comments" --jq '.[] | select(.user.login == "'"$owner"'")
        | "      #'"$number"' \(.user.login) wrote beside \(.path): \(.body)"' 2>/dev/null
done
[ "$(gh run list --workflow release --limit 1 --json conclusion --jq '.[0].conclusion' 2>/dev/null)" != failure ] ||
    echo "The last release run failed: read it with gh run view before anything else."
[ "$(gh run list --workflow check --branch main --event push --limit 1 --json conclusion --jq '.[0].conclusion' 2>/dev/null)" != failure ] ||
    echo "Main, as it stands, fails its check: read it with gh run view, and mend that before anything else."
echo "Open issues, from the agents and the owner only:"
gh issue list --limit 100 --json number,title,milestone,author --jq '.[]
    | select(.author.login == "app/sagar-agent" or .author.login == "'"$owner"'") | "  #\(.number) \(.title) [\(.milestone.title // "no milestone")]"' 2>/dev/null
echo
cat Checklists/Start.md
