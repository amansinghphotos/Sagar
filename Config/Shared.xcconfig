// How every app in Sagar is built and signed. An app's own <App>.xcconfig includes this file.

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 27.0
SWIFT_VERSION = 6.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
ALWAYS_SEARCH_USER_PATHS = NO
DEAD_CODE_STRIPPING = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ENABLE_USER_SCRIPT_SANDBOXING = YES
LD_RUNPATH_SEARCH_PATHS = @executable_path/../Frameworks
// Sparkle arrives signed; stripping it again only earns a warning.
COPY_PHASE_STRIP = NO

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = com.amansingh.$(TARGET_NAME:lower)
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities

// Scripts/release sets the version a person sees. The build number is the commit's date, so it always rises.
MARKETING_VERSION = 0
CURRENT_PROJECT_VERSION = 0

// Where the download page and every app's update feed live. $() keeps // from starting a comment.
SAGAR_SITE = https:/$()/apps.amansinghphotos.com

// Signed with the owner's Developer ID and the hardened runtime, which Apple's notary requires.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
DEVELOPMENT_TEAM = R23S9XRZN9
ENABLE_HARDENED_RUNTIME = YES
OTHER_CODE_SIGN_FLAGS = --timestamp
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
