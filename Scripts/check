#!/bin/bash
# Every rule, as one command. Run before each commit, and by GitHub on each pull request.
# The numbers come from CONSTRAINTS.md. GitHub also sets PR_NUMBER and PR_BRANCH.
set -u
cd "$(dirname "$0")/.." || exit 1
case ${1:-} in mending | locked | touring) # questions about a branch, asked with <now> and its state on standard input:
    # {"issue": its issue, as gh issue view --json state,labels,milestone gives it, "tags": [every release tag],
    #  "waiting": [every open branch], "branch": its own name, "faults": [every open fault issue]}. The platform
    # spec, Mending a Shipped App.
    # mending: the shipped app the branch mends beside the app in work, or nothing. Only an open fault in the
    #   milestone of an app that has shipped, and is not the app in work, names one: a wish waits for NOW.
    # locked: the waiting release that locks the branch: its own app's, the mended app or the app in work.
    # touring: the apps GitHub's Mac tours: the app in work, then each shipped app with an open fault.
    mends='.tags as $tags | .issue // {} | select(.state == "OPEN" and any(.labels[]?; .name == "fault"))
        | (.milestone.title // "" | capture("^(?<app>[A-Za-z]+) [0-9]+\\.[0-9]+$").app) as $app
        | ($app | ascii_downcase) as $name
        | select($name != ($now | ascii_downcase) and any($tags[]; startswith($name + "-")))
        | $app'
    [ "$1" != touring ] || mends='[$now] + ([.tags as $tags | .faults[]? | {issue: ., tags: $tags} | '"$mends"'] | unique)
        | .[]'
    [ "$1" != locked ] || mends='. as $state | ([('"$mends"')][0] // $now | ascii_downcase) as $app
        | $state.waiting[]? | select(. != $state.branch and (ascii_downcase | startswith("release/" + $app + "-")))'
    jq -r --arg now "${2:?Scripts/check $1 <now> < state}" "$mends"
    exit ;;
esac
# Anything else on the command line is a mistake, and must never fall through to running every rule.
case ${1:-} in "" | folder | leaving | clashes | merging | run | request | size | order | words | reached | apps | iphone | owed | tool | plain | shown | since | title | launch | findings | reviewed | ready) ;; *)
    echo "Usage: Scripts/check [folder | leaving | clashes <commit> | merging <owner> < state | run <status> < answer | request | size | order | ready <number> | words <file>… | reached <file>… | apps <file>… | iphone [<module>…] | owed [<file>…] | tool <command>… | plain < description | shown <file>… < description | since <owner> < state | title <title> | launch <limit> < record | findings < tests | reviewed <commit> < comments]"
    exit 2 ;;
esac
export LC_ALL=C
# Inside a commit hook git names its own folder and index in the environment. Only this script's git keeps them:
# any other tool that starts git, a package fetch or a test's own small repository, would be sent here instead.
hook=()
names=$(git rev-parse --local-env-vars) || exit 1
for name in $names; do
    [ -z "${!name+set}" ] || hook+=("$name=${!name}")
    unset "$name"
done
git() { env ${hook[@]+"${hook[@]}"} git "$@"; }
if [ "${1:-}" = tool ]; then # Scripts/check tool <command>…: runs a command as the rules run a build tool
    shift
    [ $# -gt 0 ] || { echo "Usage: Scripts/check tool <command>…"; exit 2; }
    exec "$@"
fi

if [ "${1:-}" = folder ] && [ "$(git config --global --get sagar.drive)" = yes ] &&
    [ "$(stat -f %d "$(git rev-parse --path-format=absolute --git-common-dir)")" = "$(stat -f %d "$HOME")" ]; then
    echo "This copy is not on the drive the project lives on: a Mac set up by Checklists/Build Mac.md commits only there."
    exit 1
fi
if [ "${1:-}" = folder ]; then # Scripts/check folder: the commit gate's first rule. Each chat works in its own copy;
    # the shared folder, where every chat opens, stays on clean main, and only a release commits there.
    [ "$(git rev-parse --path-format=absolute --git-dir)" = "$(git rev-parse --path-format=absolute --git-common-dir)" ] ||
        exit 0
    case $(git branch --show-current) in release/*) exit 0 ;; esac
    echo "This is the shared folder, where every chat opens. Commit from your own copy: EnterWorktree, or git worktree add."
    exit 1
fi

if [ "${1:-}" = leaving ]; then # Scripts/check leaving: before a Mac is given up, nothing of the work lives only on it.
    # Prints each thing that does, in the repository and in the private notes beside it, and fails if there is one.
    shared=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
    # A branch that ends where a merged pull request ended is on GitHub, though GitHub has deleted the branch.
    merged=$(gh pr list --state merged --limit 1000 --json headRefOid --jq '.[].headRefOid' 2>/dev/null)
    found=$(for repository in "$shared" "$shared Private"; do
        [ -d "$repository/.git" ] || { echo "No $(basename "$repository") beside the repository: clone it, or say it is not needed"; continue; }
        git -C "$repository" fetch -q --prune origin 2>/dev/null || echo "$(basename "$repository"): GitHub could not be asked"
        git -C "$repository" for-each-ref refs/heads --format='%(refname:short)' | while read -r branch; do
            ahead=$(git -C "$repository" rev-list --count "$branch" --not --remotes)
            [ "$ahead" = 0 ] || grep -qx "$(git -C "$repository" rev-parse "$branch")" <<<"$merged" || echo "$(basename "$repository"), $branch: work GitHub does not have"
        done
        git -C "$repository" worktree list --porcelain | sed -n 's/^worktree //p' | while read -r copy; do
            [ -z "$(git -C "$copy" status --porcelain 2>/dev/null)" ] || echo "$copy: changes not yet committed"
        done
        ! git -C "$repository" rev-parse -q --verify refs/stash >/dev/null || echo "$(basename "$repository"): work set aside with git stash"
    done)
    [ -n "$found" ] || { echo "Nothing lives only on this Mac."; exit 0; }
    printf '%s\n' "$found"
    exit 1
fi

if [ "${1:-}" = clashes ]; then # Scripts/check clashes <commit> [<other>]: the files where <commit> and main, as GitHub
    # has it, or another commit named, changed the same lines. Git's own merge, made in memory: nothing in the folder
    # changes.
    git rev-parse -q --verify "${2:?Scripts/check clashes <commit> [<other>]}^{commit}" >/dev/null || exit 2 # git says 1 too
    git rev-parse -q --verify "${3:-origin/main}^{commit}" >/dev/null || exit 2
    out=$(git merge-tree --write-tree --name-only --no-messages "${3:-origin/main}" "$2")
    case $? in 0) exit 0 ;; 1) printf '%s\n' "$out" | sed '1d; /^$/d'; exit 1 ;; *) exit 2 ;; esac
fi

if [ "${1:-}" = merging ]; then # Scripts/check merging <owner> < GitHub's state of a pull request: "now" only when
    # nothing is left to wait for, no check and nobody's answer. GitHub then refuses to wait, so the ready step merges it.
    # His words stand even where GitHub would merge, on files he does not own: a request for changes, a comment, or an
    # approval a later push undid.
    jq -r --arg owner "${2:?Scripts/check merging <owner> < state}" '
        if .mergeStateStatus == "CLEAN" and .reviewDecision != "CHANGES_REQUESTED"
            and ([.latestReviews[]? | select(.state == "CHANGES_REQUESTED"
                or (.author.login == $owner and .state != "APPROVED"))] | length == 0)
        then "now" else "wait" end'
    exit
fi

if [ "${1:-}" = run ]; then # Scripts/check run <gh's exit status> < what gh run view --json status,conclusion said:
    # passed, failed, running or unanswered. A pass is only ever a finished run GitHub itself called a success, and an
    # error, such as GitHub's hourly allowance running out, is no verdict either way.
    [ "${2:-1}" = 0 ] || { echo unanswered; exit; }
    jq -er 'if .status == "completed" then (if .conclusion == "success" then "passed" else "failed" end)
        elif (.status | type) == "string" and .status != "" then "running" else "unanswered" end' 2>/dev/null ||
        echo unanswered
    exit
fi

if [ "${1:-}" = ready ]; then # Scripts/check ready <number>: the one way a pull request is shown to the owner
    set -e
    request=${2:?Scripts/check ready <number>}
    repository=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
    branch=$(gh pr view "$request" --json headRefName --jq .headRefName)
    head=$(gh pr view "$request" --json headRefOid --jq .headRefOid)
    # A pull request that clashes with main would need a new push after his approval, which undoes it.
    git fetch -q origin main "$branch"
    clashing=$(Scripts/check clashes "$head") ||
        { [ -n "$clashing" ] && echo "#$request clashes with main in $(paste -sd ' ' - <<<"$clashing"). Bring it up to date with main first." ||
            echo "#$request could not be compared with main."; echo "Nobody was asked."; exit 1; }
    # Nor may it clash with a request already shown: whichever merged first would leave the other to be brought up to
    # date, and an approval of his undone, as #273 was by #262.
    for other in $(gh pr list --state open --limit 100 --json number,isDraft --jq '.[] | select(.isDraft | not) | .number'); do
        [ "$other" != "$request" ] || continue
        git fetch -q origin "pull/$other/head" &&
            clashing=$(Scripts/check clashes "$head" FETCH_HEAD) ||
            { [ -n "${clashing:-}" ] && echo "#$request clashes with #$other, already shown, in $(paste -sd ' ' - <<<"$clashing"). Wait for #$other to merge, then bring this up to date." ||
                echo "#$request could not be compared with #$other."; echo "Nobody was asked."; exit 1; }
    done
    # The words are judged here first, by the very rules GitHub runs, so a fault is told now in its own lines. GitHub
    # judges a request's words only once it is shown to someone: a draft is still being written.
    owner=${repository%/*}
    judged=$(PR_NUMBER=$request PR_BRANCH=$branch PR_HEAD=$head Scripts/check request) ||
        { printf '%s\n' "$judged" | grep -vE '^(ok|--) |^[0-9]+ rules? failed\.$'; echo "Nobody was asked."; exit 1; }
    # Given back after his review, it first tells him what changed since.
    [ "$(gh pr view "$request" --json body,latestReviews | Scripts/check since "$owner")" = yes ] ||
        { echo "He reviewed #$request: his part must answer **What Changed Since Your Review:** first. Nobody was asked."; exit 1; }
    unasked=0
    said=$(mktemp) # what gh says on the side, kept apart so that a warning is never read as GitHub's answer
    unjudged="" # set while the request is shown and GitHub has not yet passed its words
    take_back() { # any end before GitHub passed the words makes the request a draft again, out of his list
        if gh pr ready "$request" --undo >/dev/null 2>&1; then
            echo "#$request had been shown, and is a draft again."
        else
            echo "#$request is still shown, unjudged: make it a draft again with gh pr ready $request --undo."
        fi
    }
    trap 'status=$?; rm -f "$said"; [ "$status" -eq 0 ] || [ -z "$unjudged" ] || take_back' EXIT
    unanswered() { # GitHub gave no answer, as when the agents' hourly allowance runs out. It is asked again a minute
        # later; after a quarter of an hour of no answers in a row, this says so, and when GitHub can next be asked.
        unasked=$((unasked + 1))
        [ "$unasked" -ge 15 ] || { sleep 60; return; }
        echo "GitHub gave no answer about #$request for a quarter of an hour: $(head -n 1 "$said" | cut -c 1-150)"
        echo "It can be asked again from $(gh api rate_limit --jq '.resources.core.reset | strftime("%H:%M UTC")' \
            2>/dev/null || echo "the next hour"). Nobody was asked."
        exit 1
    }
    passed() { # passed <check> <since>: its newest run on the newest commit, started no earlier than <since>, passed
        local run="" answer status looked=0
        until [ -n "$run" ]; do
            answer=$(gh run list --workflow "$1" --branch "$branch" --limit 10 --json databaseId,createdAt,headSha \
                --jq "[.[] | select(.headSha == \"$head\" and .createdAt >= \"$2\")][0].databaseId // empty" 2>"$said") &&
                status=0 || status=$?
            if [ "$status" -ne 0 ]; then
                unanswered
            elif [ -n "$answer" ]; then
                run=$answer unasked=0
            else
                unasked=0
                looked=$((looked + 1))
                [ "$looked" -lt 30 ] ||
                    { echo "No $1 has run on the newest commit of #$request since its last change. Nobody was asked."; exit 1; }
                sleep 10
            fi
        done
        while :; do # asked every half minute, which spends far less of the allowance than gh run watch
            answer=$(gh run view "$run" --json status,conclusion 2>"$said") && status=0 || status=$?
            case $(Scripts/check run "$status" <<<"$answer") in
                passed) return 0 ;;
                failed) echo "The $1 on #$request failed. Nobody was asked."; exit 1 ;;
                running) unasked=0; sleep 30 ;;
                *) unanswered ;;
            esac
        done
    }
    # Two checks count. The code's ran on the newest commit. The words' ran on GitHub once the request was shown, and
    # after its description last changed.
    passed check ""
    unjudged=yes
    gh pr ready "$request" >/dev/null 2>&1
    shown=$(gh api graphql -F owner="$owner" -F name="${repository#*/}" -F number="$request" -f query='
        query($owner: String!, $name: String!, $number: Int!) { repository(owner: $owner, name: $name) {
            pullRequest(number: $number) { createdAt lastEditedAt
                timelineItems(itemTypes: [READY_FOR_REVIEW_EVENT], last: 1) { nodes { ... on ReadyForReviewEvent { createdAt } } } } } }' \
        --jq '.data.repository.pullRequest | [.createdAt, .lastEditedAt, .timelineItems.nodes[0].createdAt] |
            map(select(. != null)) | max')
    passed words "$shown"
    unjudged=""
    # If the owner answered before, he is asked again: GitHub does not do that by itself.
    if gh pr view "$request" --json reviews --jq '.reviews[].author.login' | grep -qx "$owner"; then
        gh pr edit "$request" --add-reviewer "$owner" >/dev/null
    fi
    if ! gh pr merge "$request" --auto --squash >/dev/null 2>&1; then
        # GitHub lets nobody pass the owner's review, and this merges only what has nothing left to wait for.
        state=$(gh pr view "$request" --json mergeStateStatus,reviewDecision,latestReviews)
        [ "$(Scripts/check merging "$owner" <<<"$state")" = now ] ||
            { echo "#$request waits for the owner's answer, or GitHub would not set it to merge: see gh pr view $request."; exit 1; }
        gh pr merge "$request" --squash >/dev/null
        echo "merged    #$request passed both checks on its newest commit, and had nobody left to answer"
        exit
    fi
    echo "ready     #$request passed both checks on its newest commit, and merges once whoever must answer has"
    exit
fi

failed=0
nothing=77 # what a rule returns when it had nothing to judge, so that silence is never read as a pass
rule() { # rule <name>: run the function of that name, print one line with its seconds, show its words if it fails
    local out
    local status=0 started=$SECONDS
    out=$("$1" 2>&1) || status=$?
    if [ "$status" -eq 0 ]; then
        printf 'ok    %-9s %4d s\n' "$1" "$((SECONDS - started))"
        printf '%s\n' "$out" | sed -n 's/^note: /        /p'
    elif [ "$status" -eq "$nothing" ]; then
        printf -- '--    %s (nothing to judge here)\n' "$1"
    else
        printf 'FAIL  %-9s %4d s\n' "$1" "$((SECONDS - started))"
        printf '%s\n' "$out" | tail -n 40 | sed 's/^/        /'
        failed=$((failed + 1))
    fi
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
now=$(tr -d '[:space:]' <NOW)
# The request's newest commit, when named, is judged instead of the folder: the ready step judges a request here as
# GitHub will, from whatever copy it is run in.
newest=${PR_HEAD:-HEAD}
base=$(git merge-base origin/main "$newest" 2>/dev/null || true)
[ -n "$base" ] || [ -z "${CI:-}${PR_HEAD:-}" ] ||
    { echo "origin/main or the request's newest commit is missing, so the pull request cannot be judged."; exit 1; }
branch=${PR_BRANCH:-$(git branch --show-current)}
changed() { # changed [filter]: files this branch adds, changes or removes; a moved file counts on both sides
    [ -z "$base" ] || git -c core.quotePath=false diff --no-renames --name-only ${1:+--diff-filter=$1} "$base" ${PR_HEAD:+"$PR_HEAD"}
}
words_only() { # true when the branch changes only words: documents, specs, feeds, GitHub's templates.
    # CONSTRAINTS.md is not words: the tour reads its numbers. Nor is a file inside Apps, Sources or Tests.
    [ -n "$base" ] && [ -n "$(changed)" ] && ! changed | grep -qx 'CONSTRAINTS.md' &&
        ! changed | grep -qvE '^(docs|spec|Checklists|Decisions)/|^[^/]+\.md$|^\.github/(ISSUE_TEMPLATE/|rulesets/|CODEOWNERS$|pull_request_template\.md$)'
}
if [ "${1:-}" = words ]; then # Scripts/check words <file>…: says whether a change to these files is words only
    shift
    base=given
    files=("$@")
    changed() { printf '%s\n' "${files[@]}"; }
    words_only && echo yes || echo no
    exit
fi
by_xcode_alone() { # true when the branch touches what only the app build compiles: an app's own files, the
    # settings, the project, the package. Everything else is compiled by the tests on this Mac already.
    changed | grep -qE '^(Apps|Config|Sagar\.xcodeproj)/|^Package\.(swift|resolved)$'
}
reached() { # the test targets a change can reach, joined by |: what the tests before a commit run on this Mac.
    # A module's change reaches the test targets that depend on it; a test target's change, itself. Only ScriptsTests
    # reads the scripts and hooks; it also builds the real Keep for iPhone. PicturesTests reads every approved
    # picture. An app's files are compiled by Xcode alone. Any other file, or any doubt, reaches every test: "all".
    local paths graph
    paths=$(changed)
    [ -n "$paths" ] && graph=$(swift package --scratch-path .build/reached dump-package 2>/dev/null) || { echo all; return; }
    jq -er --arg paths "$paths" '
        [.targets[] | {name, type, folder: (.path // ((if .type == "test" then "Tests/" else "Sources/" end) + .name)),
            uses: [.dependencies[] | (.byName // .target // empty)[0]]}] as $targets
        | def reaches($target): [$target] + [$targets[] | select(.name == $target) | .uses[] | reaches(.)[]];
        [$paths | split("\n")[] | select(. != "") as $file
            | if ($file | test("^Apps/")) then empty
              elif ($file | test("^(Scripts|\\.claude|\\.githooks)/")) then "ScriptsTests"
              else ([$targets[] | select(.folder as $folder | $file | startswith($folder + "/")) | .name][0] // "*"),
                  (if ($file | test("^Sources/Keep/")) then "ScriptsTests" else empty end),
                  (if ($file | test("/Pictures/.*\\.png$")) then "PicturesTests" else empty end) end] as $touched
        | if any($touched[]; . == "*") then "all"
          else [$targets[] | select(.type == "test") | .name as $test
              | select(any(reaches($test)[]; . as $module | any($touched[]; . == $module))) | $test] | join("|") end
    ' <<<"$graph" || echo all
}
if [ "${1:-}" = reached ]; then # Scripts/check reached <file>…: the test targets a change to these files can reach
    shift
    files=("$@")
    changed() { printf '%s\n' "${files[@]}"; }
    reached
    exit
fi
if [ "${1:-}" = apps ]; then # Scripts/check apps <file>…: says whether a change to these files builds the apps here
    shift
    files=("$@")
    changed() { printf '%s\n' "${files[@]}"; }
    by_xcode_alone && echo yes || echo no
    exit
fi
# What must never be shown to a visitor, in a file or in a request's own words.
key='-----BEGIN [A-Z ]*PRIVATE KEY-----|sk-ant-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}'
mail='[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[a-z]{2,}'
home='/Users/[a-z]'
allowed='@users\.noreply\.github\.com$|@example\.(com|org)$|@[0-9]x\.[a-z]+$'
owner_part() { # the owner's part of the description on standard input: what he reads, without hidden notes
    tr -d '\r' | awk '/^## For the Owner/ { on = 1; next } /^## |^<details/ { on = 0 } on' |
        awk '/<!--/ { hidden = 1 } !hidden; /-->/ { hidden = 0 }' | grep -v '^[[:space:]]*$'
}
pictures='!\[[^]]*\]\([^)]+\)|<img [^>]*>'
answers() { # answers <label>: true if a line of standard input holds the label with words after it
    awk -v label="**$1**" 'at = index($0, label) {
        if (substr($0, at + length(label)) ~ /[^[:space:]]/) answered = 1 } END { exit !answered }'
}
plain_words() { # reads a pull request's description: true if it opens with the four answers for the owner,
    # and holds no key, e-mail address or home folder path anywhere
    local whole part label
    whole=$(tr -d '\r')
    ! printf '%s\n' "$whole" | grep -oE -- "$key|$mail|$home" | grep -qvE "$allowed" || return 1
    # Where a picture shown to him is kept is no business of his part; its own words, which he reads, are.
    part=$(printf '%s\n' "$whole" | owner_part | sed -E 's/!\[([^]]*)\]\([^)]+\)/\1/g; s/<img [^>]*>//g')
    for label in 'What This Does:' 'Why:' 'Does It Change Your Apps?' 'What to Do:'; do # each asked, each answered
        printf '%s\n' "$part" | answers "$label" || return 1
    done
    # Whatever he answers is in front of him: no link sends him to another page, and no file name to the files.
    ! printf '%s\n' "$part" |
        grep -qiE '`|\]\(|https?://|www\.|<a |(Sources|Scripts|Tests|Apps|docs|Config|spec|Checklists|Decisions|\.github|\.claude)/|\.(swift|md|yml|xml|json|xcconfig|plist)\b'
}
[ "${1:-}" != plain ] || { plain_words && echo yes || echo no; exit; }
shows_all() { # shows_all <file>…: true if the owner's part of the description on standard input shows him, in
    # that one place, every must-have of each spec named and every picture named. He judges them there.
    local part file count musts=0 shown=0
    part=$(owner_part)
    for file in "$@"; do
        [ -f "$file" ] || continue
        case $file in
            *.md) # a spec with no must-haves to count would ask for nothing to be shown, so it fails
                count=$(awk '/^## / { on = tolower($0) ~ /must.?haves/; next } on && /^[0-9]+\. /' "$file" | wc -l)
                [ "$count" -gt 0 ] || return 1
                musts=$((musts + count)) ;;
            *.png) shown=$((shown + 1)) ;;
        esac
    done
    [ "$(printf '%s\n' "$part" | grep -cE '^[0-9]+\. ')" -ge "$musts" ] &&
        [ "$(printf '%s\n' "$part" | grep -oE "$pictures" | wc -l)" -ge "$shown" ]
}
[ "${1:-}" != shown ] || { shift; shows_all "$@" && echo yes || echo no; exit; }
said_since() { # said_since <owner>: reads GitHub's state of a pull request. True if the owner has not reviewed it,
    # or his newest review is an approval that stands, or his part of the description says what changed since.
    local state
    state=$(cat)
    case $(jq -r --arg owner "$1" '[.latestReviews[]? | select(.author.login == $owner) | .state][0] // "NONE"' <<<"$state") in
        NONE | APPROVED) return 0 ;;
    esac
    jq -r '.body // ""' <<<"$state" | owner_part | answers 'What Changed Since Your Review:'
}
[ "${1:-}" != since ] || { said_since "${2:?Scripts/check since <owner> < state}" && echo yes || echo no; exit; }
title_case() { # Apple's title style: the first word, and every word of four letters or more, has a capital
    printf '%s\n' "$1" | tr -- '-' ' ' | awk '{
        for (word = 1; word <= NF; word++) {
            plain = $word
            sub(/^[^A-Za-z0-9]+/, "", plain)
            if ((word == 1 || length(plain) > 3) && plain ~ /^[a-z]/ && plain !~ /[A-Z]/) exit 1
        } }
        END { if (NR == 0 || NF == 0) exit 1 }'
}
[ "${1:-}" != title ] || { title_case "${2:-}" && echo yes || echo no; exit; }
fastest_launch() { # reads a tour's record of its launches; prints the fastest and is true if that is within the limit
    # On a shared Mac a busy moment can only add time, so the fastest of the launches is the truest.
    local fastest
    fastest=$(jq '[.[].testRuns[].metrics[] | select(.identifier | test("ApplicationLaunch")) | .measurements[]] | min')
    printf '%s\n' "$fastest"
    awk -v fastest="$fastest" -v most="$1" 'BEGIN { exit !(fastest > 0 && fastest <= most) }'
}
if [ "${1:-}" = findings ]; then # Scripts/check findings < a tour's tests, as xcresulttool lists them: each audit
    # finding the tour reported as an expected failure, which does not fail it (decision 9), as a note for the summary
    jq -r '.. | objects | select(.nodeType? == "Expected Failure") | "note: \(.name)"'
    exit
fi
if [ "${1:-}" = launch ]; then
    fastest=$(fastest_launch "${2:-0}") && echo "yes $fastest" || echo "no $fastest"
    exit
fi
# The working rules: the scripts, checks, hooks, checklists, decisions and numbers.
working_rules='^(Scripts|\.github|\.claude|\.githooks|Checklists|Decisions|Tests/(UpdateTour|Pictures|ScriptsTests))/|^(SPEC|CLAUDE|CONSTRAINTS)\.md$|^\.(swift-format|gitattributes|gitignore)$'
change_of() { # change_of <commit>: a mark of what its branch changes, whatever main has become since
    local from
    from=$(git merge-base origin/main "$1" 2>/dev/null) || return 1
    git diff "$from" "$1" | git patch-id --stable | cut -d' ' -f1
}
number() { awk -F'|' -v row="$1" '$2 ~ row { gsub(/[^0-9.]/, "", $3); print $3; exit }' CONSTRAINTS.md; }
files_of() { # files_of <commit>: the files its branch changes, whatever main has become since
    git diff --name-only "$(git merge-base origin/main "$1")" "$1"
}
reviewed() { # reviewed <commit>: reads GitHub's list of a pull request's comments. True if a folded reply from the
    # agents' app says the reviewer read this change as it now stands, whatever main has become since: "read
    # <commit>". Its one small mend, the only commit since and in files the reading saw, is answered there and not read
    # again ("answered at <commit>"), but for a change to the working rules or a plan, whose mend is read again.
    [ "${#1}" -ge 7 ] || return 1
    local mark reply read answered seen mend
    same() { git cat-file -e "$1^{commit}" 2>/dev/null && [ "$(change_of "$1")" = "$mark" ]; }
    hashes() { grep -oiE "(^|[^a-z])$1 [0-9a-f]{7,40}" | grep -oE '[0-9a-f]{7,40}$' || true; }
    mark=$(change_of "$1" 2>/dev/null) || mark=""
    while IFS= read -r reply; do
        for read in $(hashes 'read(ing)?( at| of| commit)?' <<<"$reply"; grep -oiE '[0-9a-f]{7,40}[*]*: *[*]*(pass|fail)' <<<"$reply" |
            grep -oE '^[0-9a-f]{7,40}'); do
            [[ $1 == "$read"* ]] && return 0
            [ -n "$mark" ] || continue
            same "$read" && return 0
            seen=$(files_of "$read" 2>/dev/null) || continue
            ! { changed; printf '%s\n' "$seen"; } | grep -qE "$working_rules|^(spec/|SPEC\.md$|Decisions/)" || continue
            for answered in $(hashes '(answered|mended|taken) (at|in)' <<<"$reply"); do
                same "$answered" || continue
                mend=$(git rev-list --no-merges "$answered" "^$read" ^origin/main 2>/dev/null) || continue
                [ "$(wc -l <<<"$mend")" -eq 1 ] && [ -n "$mend" ] || continue
                git diff-tree --no-commit-id --name-only -r "$mend" | grep -qvxF -- "$seen" && continue
                [ "$(git diff-tree --no-commit-id --numstat -r "$mend" | awk '$1 != "-" { sum += $1 + $2 } END { print sum + 0 }')" \
                    -le "$(number 'Lines a mend changes' || true)" ] 2>/dev/null && return 0
            done
        done
    done < <(jq -r '.[] | select(.user.login == "sagar-agent[bot]" and (.body | contains("<details"))) |
        .body | gsub("[\r\n]+"; " ")')
    return 1
}
[ "${1:-}" != reviewed ] || { reviewed "${2:-}" && echo yes || echo no; exit; }
search() { # search <pattern> <allowed folders pattern>: lines in Apps and Sources outside those folders
    grep -rnE --include='*.swift' "$1" Apps Sources 2>/dev/null | grep -vE "^($2)" || true
}

size() {
    [ -n "$base" ] || return $nothing
    local most total from=$base
    most=$(number 'Changed lines')
    # While main is being merged in, the branch is measured from that main, whose own changes are not the branch's.
    if git rev-parse -q --verify MERGE_HEAD >/dev/null && git merge-base --is-ancestor MERGE_HEAD origin/main; then
        from=MERGE_HEAD
    fi
    total=$(git diff --numstat "$from" ${PR_HEAD:+"$PR_HEAD"} | awk '$1 != "-" { sum += $1 + $2 } END { print sum + 0 }')
    [ "$total" -le "$most" ] || { echo "$total changed lines; a pull request has $most at most."; return 1; }
}

release_tags() { git ls-remote --tags origin 2>/dev/null | sed -n 's|.*refs/tags/||p' | jq -R . | jq -s .; }
branch_state() { # branch_state [open branches]: what the questions about this branch read, from its issue
    local issue=${branch%%-*} state=null tags
    [[ ! $issue =~ ^[0-9]+$ ]] || state=$(gh issue view "$issue" --json state,labels,milestone 2>/dev/null) || state=null
    tags=$(release_tags)
    jq -n --argjson issue "$state" --argjson tags "${tags:-[]}" --arg branch "$branch" --arg waiting "${1:-}" \
        '{issue: $issue, tags: $tags, branch: $branch, waiting: ($waiting | split("\n") | map(select(. != "")))}'
}
mended() { branch_state | Scripts/check mending "$now"; } # the shipped app this branch mends, or nothing

scope() {
    [ -n "$base" ] || return $nothing
    local bad=0 file app mends
    mends=$(mended)
    while IFS= read -r file; do
        case $file in
            Apps/*/*) app=${file#Apps/} app=${app%%/*} ;;
            Sources/*Kit/* | Tests/*KitTests/*) app=${file#*/} app=${app%%Kit*} ;;
            Config/Shared.xcconfig) continue ;;
            Config/*.xcconfig) app=${file#Config/} app=${app%.xcconfig} ;;
            docs/*/appcast.xml) app=${file#docs/} app=${app%%/*} ;;
            *) continue ;;
        esac
        [ "$(lower "$app")" = "$(lower "$now")" ] || [ "$(lower "$app")" = "$(lower "$mends")" ] ||
            { echo "$file belongs to $app; NOW names $now, and this branch's issue mends no fault in $app."; bad=1; }
    done < <(changed)
    return $bad
}

lock() {
    [ -n "$base" ] || return $nothing
    local feeds waiting other state
    feeds=$(changed M | grep -E '^docs/.*/appcast\.xml$' || true)
    if [ -n "$feeds" ] && [[ $branch != release/* ]]; then
        echo "Only a release/<app>-<version> branch may change a feed: $feeds"
        return 1
    fi
    other=$(changed | grep -vE '^docs/(.*/appcast\.xml|index\.html)$' || true)
    if [[ $branch == release/* ]] && [ -n "$other" ]; then
        echo "A release branch changes only its feed and the page, not: $other"
        return 1
    fi
    changed | grep -qE '^(Apps|Sources|Tests)/' || return 0
    if ! waiting=$(gh pr list --state open --limit 1000 --json headRefName --jq '.[].headRefName' 2>&1); then
        [ -n "${CI:-}" ] || return $nothing
        echo "Could not ask GitHub which releases are waiting: $waiting"
        return 1
    fi
    state=$(branch_state "$waiting") && waiting=$(Scripts/check locked "$now" <<<"$state") ||
        { echo "Could not tell which release locks this branch."; return 1; }
    [ -z "$waiting" ] || { echo "This branch's app is locked: $waiting is waiting on the owner."; return 1; }
}

template() {
    [ -n "${PR_NUMBER:-}" ] || return $nothing
    local bad=0 closes line issue PR_BODY title head
    PR_BODY=$(gh pr view "$PR_NUMBER" --json body --jq .body) || { echo "Could not read the description."; return 1; }
    title=$(gh pr view "$PR_NUMBER" --json title --jq .title)
    if changed | grep -qE "$working_rules"; then
        gh pr view "$PR_NUMBER" --json labels --jq '.labels[].name' | grep -qx rules ||
            { echo "This changes the working rules, so it needs the label: gh pr edit $PR_NUMBER --add-label rules"; bad=1; }
    fi
    title_case "$title" || { echo "The title is not in Title Case: $title"; bad=1; }
    closes=$(printf '%s\n' "$PR_BODY" | grep -oiE '\b(for|close[sd]?|fix(e[sd])?|resolve[sd]?):? +#[0-9]+' |
        grep -oE '[0-9]+$' | sort -u | wc -l)
    [[ $branch == release/* ]] || [ "$closes" -eq 1 ] ||
        { echo "The description must name exactly one issue: Closes #<number>, or For #<number> if it is in a milestone."; bad=1; }
    printf '%s\n' "$PR_BODY" | plain_words ||
        { echo "The description must open with '## For the Owner' and its four answers, with no code or file names,"
          echo "and hold no key, e-mail address or home folder path anywhere."; bad=1; }
    # What he is asked to judge, he judges in one place: never by clicking through the files.
    local judged
    judged=$(changed | grep -E '^spec/.*\.md$|/Pictures/.*\.png$|\.xcassets/.*\.png$' || true)
    if [ -n "$judged" ] && ! (IFS=$'\n' && set -f && printf '%s\n' "$PR_BODY" | shows_all $judged); then
        echo "The owner's part must show him what he is asked to judge: every must-have of a changed spec, as a"
        echo "numbered list, and every changed picture, as an image. He never goes looking in the files."
        bad=1
    fi
    issue=$(printf '%s\n' "$PR_BODY" | grep -oiE '\b(for|close[sd]?|fix(e[sd])?|resolve[sd]?):? +#[0-9]+' | grep -oE '[0-9]+$' | head -1)
    # A to-do in a milestone stays open until the owner approves the release that holds its fix.
    if [[ $branch != release/* ]]; then
        local milestone closing=no
        milestone=$(gh issue view "${issue:-0}" --json milestone --jq '.milestone.title // ""') ||
            { echo "Could not read issue #${issue:-?}."; bad=1; }
        ! printf '%s\n' "$PR_BODY" | grep -qiE '\b(close[sd]?|fix(e[sd])?|resolve[sd]?):? +#[0-9]+' || closing=yes
        if [ -n "$milestone" ] && [ "$closing" = yes ]; then
            echo "Issue #$issue is in a milestone, so its release closes it: write For #$issue, not Closes."
            bad=1
        elif [ -z "$milestone" ] && [ "$closing" = no ]; then
            echo "Issue #$issue is in no milestone, so nothing else will close it: write Closes #$issue."
            bad=1
        fi
    fi
    [ "$(gh issue view "${issue:-0}" --json state --jq .state 2>/dev/null)" = OPEN ] ||
        { echo "Issue #${issue:-?} is not an open issue here."; bad=1; }
    title_case "$(gh issue view "${issue:-0}" --json title --jq .title 2>/dev/null)" ||
        { echo "Issue #${issue:-?}'s title is not in Title Case."; bad=1; }
    while IFS= read -r line; do
        printf '%s\n' "$PR_BODY" | tr -d '\r' | grep -qiFx -- "- [x] ${line#- \[ \] }" ||
            { echo "Not ticked: ${line#- \[ \] }"; bad=1; }
    done < <(grep -E '^- \[ \] ' .github/pull_request_template.md)
    # The box for the reviewer is not taken on trust: its reply must be here, and be about the change as it stands.
    head=$(gh pr view "$PR_NUMBER" --json headRefOid --jq .headRefOid)
    gh api "repos/{owner}/{repo}/issues/$PR_NUMBER/comments?per_page=100" | reviewed "$head" || {
        echo "The reviewer has not read this change as it now stands. Post its reply as a comment, folded in"
        echo "<details>, that says \"The reviewer read <commit>\". Its one mend commit is answered there, \"answered at"
        echo "<commit>\", and not read again, but for a change to the working rules or a plan: the reviewer reads"
        echo "${head:0:7}. Then run Scripts/check ready $PR_NUMBER again."
        bad=1
    }
    return $bad
}

budget() {
    local bad=0 dir module most lines file
    for dir in Sources/*/; do
        [ -d "$dir" ] || continue
        module=$(basename "$dir")
        most=$(number "^ *$module *\$")
        lines=$(find "$dir" -name '*.swift' -exec cat {} + | wc -l | tr -d ' ')
        if [ -z "$most" ]; then
            echo "$module has no line budget in CONSTRAINTS.md."
            bad=1
        elif [ "$lines" -gt "$most" ]; then
            echo "$module is $lines lines; its budget is $most."
            bad=1
        fi
    done
    most=$(number 'Main.swift')
    for file in Apps/*/*.swift; do
        [ -f "$file" ] || continue
        lines=$(wc -l <"$file" | tr -d ' ')
        case $file in
            */Tour.swift) ;;
            */Main.swift) [ "$lines" -le "$most" ] || { echo "$file is $lines lines; at most $most."; bad=1; } ;;
            *) echo "$file: an app holds only Main.swift and Tour.swift; the rest belongs in its Kit."; bad=1 ;;
        esac
    done
    return $bad
}

imports() {
    local found
    found=$(search '\bimport +((class|struct|enum|protocol|func|var|let|typealias) +)?(AppKit|Cocoa|Carbon)\b' \
        'Sources/(Shell|Taps)/|Sources/[A-Za-z]+Kit/Mac/')
    [ -z "$found" ] || { echo "AppKit belongs only in Shell, Taps and a Kit's Mac folder:"; echo "$found"; return 1; }
}

look() {
    local found
    found=$(search '\b(NS|UI)?(Color|Font)\b|#colorLiteral|\.font\(|\.(foreground(Style|Color)|tint|background|fill|stroke|border)\(\.[a-z]' \
        'Sources/Look/|Apps/[A-Za-z]+/Tour\.swift')
    [ -z "$found" ] || { echo "A colour or font named outside Look, which gives screens their roles:"; echo "$found"; return 1; }
}

network() {
    local found
    found=$(search '\bURLSession\b|\bURLRequest\b|\bAsyncImage\b|\bNW(Connection|Listener|Browser)\b|import +(Network|Sparkle|WebKit|CFNetwork)\b' \
        'Sources/(Shell|Minds)/')
    [ -z "$found" ] || { echo "Network code belongs only in Shell and Minds:"; echo "$found"; return 1; }
}

secrets() {
    local bad=0 found
    found=$(git ls-files -co --exclude-standard -z | xargs -0 grep -nIE -- '^(<{7}|>{7}) |^={7}$' 2>/dev/null | cut -c1-120 || true)
    [ -z "$found" ] || { echo "A merge was left unfinished:"; echo "$found"; bad=1; }
    found=$(git ls-files -co --exclude-standard -z | xargs -0 grep -nIoE -- "$key|$mail|$home" 2>/dev/null |
        grep -vE "$allowed" || true)
    [ -z "$found" ] || { echo "A key, an e-mail address or a home folder path:"; echo "$found"; bad=1; }
    if [ -n "$base" ]; then
        found=$(git log --no-merges --format='%ae%n%ce' "$base..$newest" | sort -u |
            grep -vE '@users\.noreply\.github\.com$|^noreply@github\.com$' || true)
        [ -z "$found" ] || { echo "A commit without GitHub's no-reply address: $found"; bad=1; }
    fi
    return $bad
}

format() {
    local folders=()
    for folder in Apps Sources Tests; do [ -d "$folder" ] && folders+=("$folder"); done
    swift format lint --strict --recursive ${folders[@]+"${folders[@]}"} Package.swift
}

build() {
    [ -d Sources ] || [ -d Tests ] || return $nothing
    ! words_only || return $nothing
    local app
    compile swift build --build-tests || return 1
    for app in Apps/*/; do
        [ -d "$app" ] || continue
        # GitHub's Mac builds every app. This Mac does only when the change touches what nothing else here compiles.
        [ -n "${CI:-}" ] || by_xcode_alone || { echo "note: the apps are built on GitHub's Mac"; break; }
        compile xcodebuild -project Sagar.xcodeproj -scheme "$(basename "$app")" -derivedDataPath .build/Xcode \
            -quiet build CODE_SIGNING_ALLOWED=NO || return 1
    done
}

compile() { # run a build; any warning or error fails it, and only those lines are shown
    local log status problems
    log=$("$@" 2>&1)
    status=$?
    problems=$(printf '%s\n' "$log" | sed $'s/\x1b\\[[0-9;]*m//g' | grep -E '^[^ ].*: (error|warning): ' | cut -c 1-300 | sort -u)
    [ -z "$problems" ] || { echo "$problems"; return 1; }
    [ "$status" -eq 0 ] || { printf '%s\n' "$log" | tail -n 15 | cut -c 1-300; return 1; }
}

phone="Keep" # the shared modules that build for iPhone today. Look joins them when issue 153 is mended.
iphone() { # The shared parts still build for iPhone. Compiled for its SDK alone: no Simulator, nothing on screen.
    # The first build in a folder takes some 10 s and each one after about 3, so it runs before every commit.
    ! words_only || return $nothing
    local module version sdk targets=()
    for module in $phone; do
        [ -d "Sources/$module" ] || { echo "$module is listed for iPhone, and is no module in Sources."; return 1; }
        targets+=(--target "$module")
    done
    [ ${#targets[@]} -gt 0 ] || { echo "No module is listed for iPhone, so nothing would be built."; return 1; }
    # Apple gives iPhone's system the Mac's number, so the package's one number serves both.
    version=$(sed -n 's/.*\.macOS(\.v\([0-9]*\)).*/\1/p' Package.swift)
    sdk=$(xcrun --sdk iphoneos --show-sdk-path 2>/dev/null)
    [ -n "$version" ] && [ -n "$sdk" ] || { echo "No system number in Package.swift, or no iPhone SDK in this Xcode."; return 1; }
    compile swift build "${targets[@]}" --triple "arm64-apple-ios$version.0" --sdk "$sdk"
}

tests() { # GitHub's Mac runs every test. Before a commit this Mac runs those the change can reach.
    [ -d Tests ] || return $nothing
    ! words_only || return $nothing
    local reach=all
    [ -n "${CI:-}" ] || reach=$(reached)
    case $reach in
        all) swift test --quiet 2>&1 ;;
        "") return $nothing ;; # no test can reach it; GitHub's Mac runs them all
        *) echo "note: these tests run here: ${reach//|/, }; GitHub's Mac runs every test"
            swift test --quiet --filter "^($reach)\." 2>&1 ;;
    esac
}

tour() { # The real app, driven as a person would. It takes the screen, so it runs only on GitHub's runner.
    [ -n "${CI:-}" ] || return $nothing
    ! words_only || return $nothing
    local faults tags apps app toured=no
    faults=$(gh issue list --state open --label fault --limit 100 --json state,labels,milestone) &&
        tags=$(release_tags) &&
        apps=$(jq -n --argjson faults "$faults" --argjson tags "$tags" '{faults: $faults, tags: $tags}' |
            Scripts/check touring "$now") || { echo "Could not tell which apps to tour."; return 1; }
    mkdir -p .build/Tours
    for app in $apps; do # the app in work, then each shipped app whose fault is being mended
        [ -f "Apps/$app/Tour.swift" ] || continue
        tour_of "$app" || return 1
        toured=yes
    done
    [ $toured = yes ] || return $nothing
}

tour_of() { # tour_of <app>: its tour passes, and its launch and its rest are within the numbers
    local app=$1 log launch before after result=.build/Tours/$1.xcresult
    log=$(xcodebuild -project Sagar.xcodeproj -scheme "${app}Tour" -derivedDataPath .build/Xcode \
        -resultBundlePath "$result" test \
        CODE_SIGN_IDENTITY=- ENABLE_HARDENED_RUNTIME=NO OTHER_CODE_SIGN_FLAGS= 2>&1) || {
        xcrun xcresulttool get test-results summary --path "$result" |
            jq -r '.testFailures[] | "\(.testName): \(.failureText)"' || printf '%s\n' "$log" | tail -n 20
        return 1
    }
    xcrun xcresulttool get test-results tests --path "$result" | Scripts/check findings ||
        { echo "$app's tour: its audit findings could not be read."; return 1; }

    # Launch, by Apple's own launch metric, which the tour must take.
    launch=$(xcrun xcresulttool get test-results metrics --path "$result" |
        fastest_launch "$(number 'Launch to first frame')") ||
        { echo "$app's tour: its fastest launch was $launch s."; return 1; }
    echo "note: $app, fastest of its launches $launch s"

    # At rest: opened hidden, left alone, and measured from outside.
    used() {
        ps -xo cputime=,comm= | awk -v app="/$app.app/Contents/MacOS/$app" \
            'index($0, app) { split($1, part, ":"); print part[1] * 60 + part[2] }'
    }
    open -g -j ".build/Xcode/Build/Products/Release/$app.app" && sleep 5
    before=$(used) && sleep 10 && after=$(used)
    pkill -f "/$app.app/Contents/MacOS/$app"
    [ -n "$before" ] && [ -n "$after" ] || { echo "$app did not stay open."; return 1; }
    awk -v app="$app" -v before="$before" -v after="$after" -v most="$(number 'Processor time while')" 'BEGIN {
        percent = (after - before) * 10
        printf "note: " app ", hidden for 10 s it used %.1f%% of a processor\n", percent
        exit !(percent <= most)
    }'
}

order() { # The two lists every new part adds to are alphabetical, so two pieces of work add theirs in different places.
    local list
    list=$(sed -n '/^    targets: \[/,/^    \]/p' Package.swift | tr '\n' ' ' |
        grep -oE '[tT]arget\([[:space:]]*name: "[^"]+"' | cut -d'"' -f2)
    [ "$list" = "$(sort <<<"$list")" ] || { echo "Package.swift: the targets are not in alphabetical order."; return 1; }
    # A blank line between two parts keeps a change to one apart from a change to the next: git merges them both.
    sed -n '/^    targets: \[/,/^    \]/p' Package.swift | sed 's/^[[:space:]]*$/ GAP /' | tr '\n' ' ' |
        grep -oE '[tT]arget\([[:space:]]*name: "[^"]+"| GAP ' | awk -F'"' '
        / GAP / { gap = 1; next }
        { part = $2; sub(/Tests$/, "", part) }
        NR > 1 && part != last && !gap { print "Package.swift: put a blank line between " last " and " part "."; bad = 1 }
        { last = part; gap = 0 }
        END { exit bad }' || return 1
    list=$(awk '/^## Line Budget/ { on = 1; next } /^## / { on = 0 } on && /^\| [A-Za-z]+ \|/ { print $2 }' CONSTRAINTS.md |
        grep -vx Module)
    [ "$list" = "$(sort <<<"$list")" ] || { echo "CONSTRAINTS.md: the line budget is not in alphabetical order."; return 1; }
}

# Nothing of Search's is pasted, so nothing is owed to it, and its notice stays gone (decision 8). Judges the files
# named after `owed`, or every file the repository keeps but the decisions, which record the history, and this
# script, which holds the words it looks for. A named file that cannot be read fails.
owed() {
    local found status pasted='Office Commun|Taken from Search'
    if [ ${#named[@]} -gt 0 ]; then
        found=$(grep -nIE "$pasted" "${named[@]}") && status=0 || status=$?
    else
        found=$(git grep -nIE "$pasted" -- . ':!Decisions/' ':!Scripts/check') && status=0 || status=$?
    fi
    [ "$status" -le 1 ] || { echo "Could not read what was named."; return 1; }
    [ -z "$found" ] || { echo "Search's notice or a line taken from Search, though nothing of it is pasted (decision 8):"; echo "$found"; return 1; }
}

# A request's words and label are judged by themselves, in seconds, whenever they change. Everything
# else is judged once for each change to the code.
[ "${1:-}" = request ] && rules="template" || rules="size scope lock template order budget imports look owed network secrets format build iphone tests tour"
[ "${1:-}" != size ] || rules="size"
[ "${1:-}" != order ] || rules="order"
named=()
if [ "${1:-}" = owed ]; then # Scripts/check owed [<file>…]: that rule alone, of the files named or the whole repository
    rules="owed"
    named=("${@:2}")
fi
if [ "${1:-}" = iphone ]; then # Scripts/check iphone [<module>…]: that rule alone, of the modules named or its own
    rules="iphone"
    [ $# -lt 2 ] || phone="${*:2}"
fi
for name in $rules; do
    rule "$name"
done
[ "$failed" -eq 0 ] && echo "All rules hold." || echo "$failed rules failed."
exit "$((failed > 0))"
