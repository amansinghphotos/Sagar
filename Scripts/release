#!/bin/bash
# One release of one app. The Release issue is its checklist.
#   printf 'New: …\nBetter: …\nFixed: …\n' | Scripts/release <App> <version>    the try, on the owner's Mac
#                                               (a line with nothing to say is left out, but one stays)
#   Scripts/release why < notes                 the owner's reason from the first line there, or nothing if not allowed
#   Scripts/release <App> <version> withdraw    he reported a fault: mend it, then offer the same number again
#   Scripts/release <App> <version> publish     run by GitHub when his approval merges the pull request
#   Scripts/release follows <last> <next>       says whether one version may follow another
#   Scripts/release may <App> <now> < state     why a release of <App> may not start yet, or nothing
#   Scripts/release opens <app path>            item or menu: where the update tour asks that app for updates
#   Scripts/release quitting <identifier> <executable>    closed, quit or stayed: asks an open app for its place
#   Scripts/release notice <App> <version> <passed|failed> <owner> <why> < comments    the note that tells him, if any
set -euo pipefail
cd "$(dirname "$0")/.."

follows() { # follows <last> <next>: yes if <next> is the next second number, or a new first number with .0
    awk -F. -v last="${1:-0.0}" -v want="$2" 'BEGIN {
        split(last, was, ".")
        print (want == was[1] "." was[2] + 1 || want == was[1] + 1 ".0") ? "yes" : "no" }'
}
[ "${1:-}" != follows ] || { follows "${2:-}" "${3:-}"; exit; }

may() { # may <App> <now> < {"open": [every open branch], "milestone": [its open issues, with their labels]}: why
    # it may not start yet, or nothing. One build waits for him at a time, and an app NOW does not name ships
    # faults only (the platform spec, Mending a Shipped App). Other open work never holds a release back.
    jq -r --arg app "$1" --arg now "$2" '
        ([.open[]? | select(startswith("release/"))][0] // empty | "\(.) is waiting for the owner. One build waits at a time."),
        (select(($app | ascii_downcase) != ($now | ascii_downcase))
            | [.milestone[]? | select(any(.labels[]?; .name == "fault" or .name == "release") | not) | .number]
            | select(length > 0)
            | "\($app) is mended beside the app in work, so it ships faults only, not #\(map(tostring) | join(", #")).")'
}
[ "${1:-}" != may ] || { may "${2:-}" "${3:-}"; exit; }

opens() { # opens <app path>: how a person asks the app for updates. An app kept out of the Dock has no menu of
    # its own, so from its item in the menu bar; any other from its menu. Read from the app, never from its name.
    [ "$(plutil -extract LSUIElement raw -o - "$1/Contents/Info.plist" 2>/dev/null)" = true ] && echo item || echo menu
}
[ "${1:-}" != opens ] || { opens "${2:-}"; exit; }

why() { # why < notes: the owner's reason for a release, if its notes are allowed. The notes are New, Better and Fixed
    # lines in that order, each with something to say, one at least, and no issue number, code or dollar sign, which
    # the build would fill in. The reason is the first line that is there: what is new, else what is better, else what
    # is mended.
    local notes first
    notes=$(cat)
    awk 'BEGIN { rank["New"] = 1; rank["Better"] = 2; rank["Fixed"] = 3 }
        $0 !~ /^(New|Better|Fixed): +[^[:space:]]/ { bad = 1; next }
        { label = $0; sub(/: .*/, "", label); if (rank[label] <= last) bad = 1; last = rank[label] }
        END { exit bad }' <<<"$notes" || return 1
    ! grep -q '[#`$]' <<<"$notes" || return 1
    first=$(head -n 1 <<<"$notes" | sed 's/^[A-Za-z]*: *//')
    printf '%s%s\n' "$(tr '[:lower:]' '[:upper:]' <<<"${first:0:1}")" "${first:1}"
}
[ "${1:-}" != why ] || { why; exit; }

notice() { # notice <App> <version> <passed|failed> <owner> <why> < the release pull request's comments, as GitHub lists
    # them. Prints the note to post there for the owner, or nothing: a failed proof is said once, and so is a later pass.
    local said
    said=$(jq -r '[.[].body | capture("<!-- proof (?<ended>passed|failed) -->").ended] | last // "passed"')
    [ "$3" != "$said" ] || return 0
    if [ "$3" = failed ]; then
        printf '@%s **%s %s failed its last check, after you approved it.**\n' "$4" "$1" "$2"
        printf "GitHub's Mac tried getting it the way people will. It didn't work.\n"
        printf 'Say "the %s check failed" in any chat, and we'\''ll mend it.\n\n' "$1"
        printf '<details><summary>For the Agents</summary>\n\n%s\n\n</details>\n' "$5"
    else
        printf '@%s **%s %s has now passed its last check.**\n' "$4" "$1" "$2"
        printf "A second try worked. There's nothing for you to do.\n"
    fi
    printf '<!-- proof %s -->\n' "$3"
}
[ "${1:-}" != notice ] || { shift; notice "$@"; exit; }

quitting() { # quitting <identifier> <executable>: closed if it is not running. Else it is asked to quit the normal way,
    # by a notification any process may post and none needs a permission for; then quit, or stayed if it still runs
    # after WAIT seconds (10 unless told).
    local running="^$2( |\$)" tenths=0
    pgrep -qf "$running" || { echo closed; return; }
    notifyutil -p "$1.new-build"
    while pgrep -qf "$running"; do
        [ "$tenths" -lt $((${WAIT:-10} * 10)) ] || { echo stayed; return; }
        sleep 0.1
        tenths=$((tenths + 1))
    done
    echo quit
}
[ "${1:-}" != quitting ] || { quitting "${2:?}" "${3:?}"; exit; }

app=${1:?Usage: Scripts/release <App> <version> [withdraw|publish]}
version=${2:?Usage: Scripts/release <App> <version> [withdraw|publish]}
name=$(printf '%s' "$app" | tr '[:upper:]' '[:lower:]')
tag=$name-$version
branch=release/$tag
out=.build/Release/$app
feed=docs/$name/appcast.xml
site=$(sed -n 's|^SAGAR_SITE = ||p' Config/Shared.xcconfig | sed 's|/\$()/|//|')
repository=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
files=https://github.com/$repository/releases/download
stop() { echo "$1"; exit 1; }
versions() { grep -o '<sparkle:shortVersionString>[^<]*' "$feed" | sed 's/.*>//'; }
install() { # install <disk image>: the app from the image takes the place of the one in Applications.
    # The new copy is whole and beside the old one before they swap, so a failure never leaves no app.
    local mount
    mount=$(mktemp -d)
    hdiutil attach -quiet -nobrowse -readonly -mountpoint "$mount" "$1"
    rm -rf "/Applications/.$app.arriving.app"
    ditto "$mount/$app.app" "/Applications/.$app.arriving.app"
    hdiutil detach -quiet "$mount"
    mkdir -p "$out"
    rm -rf "$out/Replaced.app"
    [ ! -e "/Applications/$app.app" ] || mv "/Applications/$app.app" "$out/Replaced.app"
    mv "/Applications/.$app.arriving.app" "/Applications/$app.app"
}

case ${3:-} in
withdraw)
    held=$(gh release view "$tag" --json isDraft --jq .isDraft 2>/dev/null || echo none)
    [ "$held" != false ] ||
        stop "$app $version is already published and cannot be withdrawn. Mend it and release the next number."
    gh pr close "$branch" --delete-branch --comment "Withdrawn to be mended. $app $version will be offered again." >/dev/null 2>&1 || true
    [ "$held" != true ] || gh release delete "$tag" --yes >/dev/null # only ever a draft
    git branch -q -D "$branch" 2>/dev/null || true
    # His Mac goes straight back to the last version he approved, if there is one.
    shipped=$(git ls-remote --tags origin "refs/tags/$name-*" | sed "s|.*refs/tags/$name-||" | sort -t. -k1,1n -k2,2n | tail -1)
    here=$(defaults read "/Applications/$app.app/Contents/Info" CFBundleShortVersionString 2>/dev/null || true)
    if [ -n "$shipped" ] && [ "$here" = "$version" ]; then # only if the withdrawn build is what his Mac has
        mkdir -p "$out"
        gh release download "$name-$shipped" --pattern "$app-$shipped.dmg" --output "$out/shipped.dmg" --clobber
        install "$out/shipped.dmg"
        echo "restored  /Applications/$app.app is $shipped again, the last version he approved"
    fi
    echo "withdrawn $app $version; mend it and offer the same number again"
    exit 0
    ;;
publish) # On GitHub's clean Mac: make the tried file public, then be the person who has the previous version.
    why="It stopped without saying why."
    stop() { why=$1; echo "$1"; exit 1; }
    told() { # told <passed|failed>: however this ends, the pull request he approved gets the note it calls for, if any
        local request words
        request=$(gh pr list --state merged --head "$branch" --json number --jq '.[0].number // empty')
        [ -n "$request" ] || return 0
        words=$(gh api "repos/$repository/issues/$request/comments?per_page=100" | notice "$app" "$version" "$1" \
            "${repository%/*}" "$why ${GITHUB_SERVER_URL:-}/$repository/actions/runs/${GITHUB_RUN_ID:-}")
        [ -z "$words" ] || gh api "repos/$repository/issues/$request/comments" -f body="$words" >/dev/null
    }
    trap 'ended=$?; told "$([ "$ended" -eq 0 ] && echo passed || echo failed)" || true; exit "$ended"' EXIT
    [ "$(versions | head -1)" = "$version" ] || stop "$feed does not lead with $version."
    gh release edit "$tag" --draft=false >/dev/null
    mkdir -p "$out"
    for _ in $(seq 60); do # the page takes a minute or two to follow main
        curl -fsS "$site/$name/appcast.xml" 2>/dev/null | cmp -s - "$feed" && break
        sleep 10
    done
    curl -fsS "$site/$name/appcast.xml" | cmp -s - "$feed" || stop "The live feed is not the approved one."
    curl -fsS "$site/" | grep -q "$files/$tag/$app-$version.dmg" || stop "The page does not offer $app $version."
    curl -fsSL "$files/$tag/$app-$version.dmg" -o "$out/new.dmg"
    spctl --assess --type open --context context:primary-signature "$out/new.dmg" || stop "Gatekeeper refuses the download."
    previous=$(versions | sed -n 2p)
    if [ -z "$previous" ]; then # a first release: the download opens on a clean Mac
        install "$out/new.dmg"
        open -g -j "/Applications/$app.app" && sleep 5
        pkill -f "/$app.app/Contents/MacOS/$app" || stop "$app $version did not stay open."
    else # an update: the previous download, asked for updates, takes this one
        curl -fsSL "$files/$name-$previous/$app-$previous.dmg" -o "$out/previous.dmg"
        install "$out/previous.dmg"
        TEST_RUNNER_APP=$app TEST_RUNNER_OPENS=$(opens "/Applications/$app.app") TEST_RUNNER_IDENTIFIER=$(defaults read "/Applications/$app.app/Contents/Info" CFBundleIdentifier) \
            xcodebuild -project Sagar.xcodeproj -scheme UpdateTour -derivedDataPath .build/Xcode \
            -resultBundlePath .build/Update.xcresult -quiet test \
            CODE_SIGN_IDENTITY=- ENABLE_HARDENED_RUNTIME=NO OTHER_CODE_SIGN_FLAGS= >/dev/null 2>&1 ||
            stop "$app $previous did not take the update: $(xcrun xcresulttool get test-results summary \
                --path .build/Update.xcresult | jq -r '[.testFailures[].failureText] | join("; ")')"
        took=$(defaults read "/Applications/$app.app/Contents/Info" CFBundleShortVersionString)
        [ "$took" = "$version" ] || stop "After updating, the installed copy is $took, not $version."
    fi
    echo "published $app $version: the page offers it, Gatekeeper accepts it${previous:+, and $previous took the update}"
    exit 0
    ;;
esac

profile=${NOTARY_PROFILE:-Sagar}
tools=$(find .build -type d -path '*artifacts/sparkle/Sparkle/bin' 2>/dev/null | head -1 || true)
notes=$(cat)
reason=$(why <<<"$notes") ||
    stop "The notes are plain lines on standard input: New: …, Better: …, Fixed: …, in that order. Leave out a line with nothing to say, but keep one. No issue numbers, code or dollar signs."
[ -x "$tools/generate_appcast" ] || stop "Sparkle's tools are missing: run swift build first."
[ "$(git branch --show-current)" = main ] && [ -z "$(git status --porcelain)" ] || stop "Start from a clean main."
git fetch -q origin main
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || stop "main is not what GitHub has."
[ -f "$feed" ] && grep -q "data-app=\"$name\"" docs/index.html ||
    stop "$feed or the page's entry is missing: see Checklists/New App.md."
open=$(gh pr list --state open --limit 1000 --json headRefName --jq '[.[].headRefName]') &&
    milestone=$(gh issue list --state open --search "milestone:\"$app $version\"" --json number,labels) ||
    stop "Could not ask GitHub what is open."
why=$(jq -n --argjson open "$open" --argjson milestone "$milestone" '{open: $open, milestone: $milestone}' |
    may "$app" "$(tr -d '[:space:]' <NOW)")
[ -z "$why" ] || stop "$why"
issue=$(gh issue list --state open --json number,title \
    --jq "[.[] | select(.title == \"Release $app $version\")][0].number // empty")
[ -n "$issue" ] || stop "Open the Release issue titled 'Release $app $version' first."
! gh issue view "$issue" --json body --jq .body | grep -q '^- \[ \]' ||
    stop "The Release issue still has a box unticked. Tick each once it is true."
fixes=$(gh issue list --state open --search "milestone:\"$app $version\"" --json number \
    --jq "[.[] | select(.number != $issue) | .number] | .[]") || stop "Could not read the milestone '$app $version'."
for fix in $fixes; do # the release closes these, so each must really have its fix merged
    merged=$(gh pr list --state merged --search "\"For #$fix\" in:body" --json number --jq length)
    [ "$merged" -gt 0 ] || stop "Issue #$fix is in the milestone, but no merged pull request says For #$fix."
done
# The number: two parts, and the next one after the last version that shipped. A build he sent back
# is mended and offered again under the same number; its date stamp tells the tries apart.
last=$(git ls-remote --tags origin "refs/tags/$name-*" | sed "s|.*refs/tags/$name-||" | sort -t. -k1,1n -k2,2n | tail -1)
next=$(follows "${last:-}" "$version")
[ "$next" = yes ] || stop "After ${last:-no release} comes the next second number, or a new first number with .0: not $version."
! gh release view "$tag" >/dev/null 2>&1 || stop "A build of $app $version is already waiting. Withdraw it first."

notarise() { # Apple's check, then its ticket stapled on, so the file opens offline
    local answer
    answer=$(xcrun notarytool submit "$1" --keychain-profile "$profile" --wait 2>&1) || true
    grep -q 'status: Accepted' <<<"$answer" || { echo "$answer"; stop "Apple's notary did not accept $1"; }
    xcrun stapler staple -q "$2"
}

# GitHub's Mac has passed main as it stands, tour included, before a build can reach anyone's Mac.
run=$(gh run list --workflow check --branch main --event push --limit 1 --json databaseId,headSha \
    --jq ".[0] | select(.headSha == \"$(git rev-parse HEAD)\") | .databaseId")
[ -n "$run" ] && gh run watch "$run" --exit-status >/dev/null 2>&1 ||
    stop "GitHub's Mac has not passed main as it stands: see gh run list --workflow check --branch main."

NOTES="$notes" Scripts/build "$app" "$version"
image=$out/$app-$version.dmg
ditto -c -k --keepParent "$out/$app.app" "$out/$app.zip"
notarise "$out/$app.zip" "$out/$app.app"
folder=$(mktemp -d)
ditto "$out/$app.app" "$folder/$app.app"
ln -s /Applications "$folder/Applications"
hdiutil create -quiet -volname "$app" -srcfolder "$folder" -format UDZO -ov "$image"
codesign --sign "Developer ID Application" --timestamp "$image"
notarise "$image" "$image"
spctl --assess --type open --context context:primary-signature "$image" || stop "Gatekeeper refuses the disk image."
spctl --assess --type execute "$out/$app.app" || stop "Gatekeeper refuses the app."
echo "notarised $image"

# From here on things exist outside this folder. If a step fails, take them all back.
undo() {
    git switch -q -f main 2>/dev/null
    "$0" "$app" "$version" withdraw >/dev/null
    echo "Nothing was released: the branch and the draft are taken back."
}
trap undo ERR

# The feed: Sparkle's own tool signs the file and the feed with the update key in the login keychain.
git switch -q -c "$branch"
archives=$(mktemp -d)
cp "$image" "$archives/"
cp "$feed" "$archives/appcast.xml"
printf '%s\n' "$notes" >"$archives/$app-$version.txt"
"$tools/generate_appcast" --download-url-prefix "$files/$tag/" --link "$site/" --embed-release-notes \
    --maximum-deltas 0 --maximum-versions 0 "$archives" >/dev/null 2>&1
cp "$archives/appcast.xml" "$feed"
"$tools/sign_update" --verify "$feed" >/dev/null
[ "$(versions | head -1)" = "$version" ]
sed -i '' -E "s|href=\"[^\"]*\"( data-app=\"$name\">)[^<]*|href=\"$files/$tag/$app-$version.dmg\"\\1Download $app $version|" docs/index.html
grep -q "$files/$tag/$app-$version.dmg" docs/index.html

git add "$feed" docs/index.html
git commit -q -m "Release $app $version" -m "$notes" >/dev/null
git push -q -u origin "$branch"
gh release create "$tag" "$image" --draft --target "$(git rev-parse origin/main)" \
    --title "$app $version" --notes "$notes" >/dev/null
request=$(gh pr create --draft --title "Release $app $version" --body "## For the Owner

**What This Does:** Sends $app $version to everyone who has $app. It's in your Applications folder now, so you can try it first.

**Why:** $reason

**Does It Change Your Apps?** Yes. Everyone who has $app is offered $version. They choose when to install it.

**What to Do:** Quit $app if it's open. Then open it from your Applications folder and try it. If it's right, approve. If something's wrong, choose Request changes and say what happened.

<details><summary>Checklist for the Agents</summary>

Closes #$issue$(for fix in $fixes; do printf ', closes #%s' "$fix"; done)

$(grep -E '^- \[ \] ' .github/pull_request_template.md)

</details>")
trap - ERR
git switch -q main

# Installed whole on this Mac, for him to try: the same file that will ship. If he has the app open, it is asked to
# quit first, and the new build opens in its place behind his windows, to show what is new without taking his keys.
# If it was closed, or did not quit, nothing opens: it shows what is new when he next opens it.
was=$(quitting "$(defaults read "$PWD/$out/$app.app/Contents/Info" CFBundleIdentifier)" "/Applications/$app.app/Contents/MacOS/$app")
install "$image"
echo "installed /Applications/$app.app"
if [ "$was" = quit ]; then open -g "/Applications/$app.app" && echo "reopened  $app, behind his windows"; fi
[ "$was" != stayed ] || echo "          $app did not quit: what is new shows when he next opens it"
echo "drafted   $request"
echo "          Say in its What to Do what he should try. Tick its boxes once each is true."
echo "          Then: Scripts/check ready <its number>. That asks the owner, and his approval ships it."
